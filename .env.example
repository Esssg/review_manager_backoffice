VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional during the Q50=B migration. When unset, the legacy direct-Supabase
# compatibility path remains active. Self-hosted staging uses /api/admin-gateway
# through the backoffice container Nginx; do not enable until canary checks pass.
VITE_ADMIN_GATEWAY_URL=
VITE_ADMIN_GATEWAY_ENABLED=false
# Set true only after every administrator data service has moved to the gateway
# and staging/canary regression checks have passed.
VITE_ADMIN_GATEWAY_READY=false

# Docker Compose host port (optional, defaults to 8080)
APP_PORT=8080

# Node script fallback variables (optional if you already use VITE_* keys)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
